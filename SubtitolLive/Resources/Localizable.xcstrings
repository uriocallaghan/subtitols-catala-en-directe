    "Els models s'han convertit i comprimit per funcionar a l'aparell. Les llicències completes s'enllacen a les condicions d'ús.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The models were converted and compressed to run on the device. The full licenses are linked from the terms of use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos se han convertido y comprimido para funcionar en el dispositivo. Las licencias completas se enlazan en las condiciones de uso."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ereduak bihurtu eta trinkotu egin dira gailuan funtziona dezaten. Lizentzia osoen estekak erabilera-baldintzetan daude."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos convertéronse e comprimíronse para funcionar no dispositivo. As licenzas completas están ligadas nas condicións de uso."
          }
        }
      }
    },
