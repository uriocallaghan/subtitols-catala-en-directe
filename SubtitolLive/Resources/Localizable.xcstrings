    "Les correccions dels subtítols no s'han pogut desar en aquest Mac. Exporta el vídeo o els subtítols per conservar-les.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido guardar las correcciones de los subtítulos en este Mac. Exporta el vídeo o los subtítulos para conservarlas."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Non se puideron gardar as correccións dos subtítulos neste Mac. Exporta o vídeo ou os subtítulos para conservalas."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezin izan dira azpitituluen zuzenketak Mac honetan gorde. Esportatu bideoa edo azpitituluak gordetzeko."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subtitle corrections couldn't be saved on this Mac. Export the video or the subtitles to keep them."
