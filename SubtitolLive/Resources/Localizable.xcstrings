    "És una transcripció automàtica. No substitueix un servei professional de subtitulació ni cap aparell auditiu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's an automatic transcript. It doesn't replace a professional captioning service or any hearing device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una transcripción automática. No sustituye a un servicio profesional de subtitulado ni a ningún audífono."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripzio automatikoa da. Ez ditu ordezkatzen azpitituluen zerbitzu profesionalak ezta audifonoak ere."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "É unha transcrición automática. Non substitúe un servizo profesional de subtitulación nin ningún aparello auditivo."
          }
        }
      }
    },
