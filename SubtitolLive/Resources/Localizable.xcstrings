    "Noms, llocs i sigles d'avui. El motor els afavoreix i surten escrits bé.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's names, places and acronyms. The recogniser favours them, so they come out right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres, lugares y siglas de hoy. El motor los favorece y salen bien escritos."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes, lugares e siglas de hoxe. O motor favoréceos e saen ben escritos."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaurko izenak, lekuak eta siglak. Motorrak lehenesten ditu eta ondo idatzita ateratzen dira."
          }
        }
      }
    },
    "Amb %lld termes n'hi ha prou: més, i el motor ja no en distingeix cap.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld terms are enough: with more, the recogniser no longer tells any apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con %lld términos basta: con más, el motor ya no distingue ninguno."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Con %lld termos abonda: con máis, o motor xa non distingue ningún."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld terminorekin nahikoa da: gehiagorekin motorrak ez du bat ere bereizten."
          }
        }
      }
    },
