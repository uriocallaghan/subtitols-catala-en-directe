    },
    "Encara no hi ha cap transcripció. duna no en guarda cap quan es tanca.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha cap transcripció. duna no en guarda cap quan es tanca."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no transcript yet. duna doesn't keep any once it closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ninguna transcripción. duna no guarda ninguna cuando se cierra."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraindik ez dago transkripziorik. duna-k ez du bat ere gordetzen ixten denean."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
