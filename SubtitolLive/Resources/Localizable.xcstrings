    "Per a una sala, el micròfon de l'iPhone o un de cable acostumen a sentir-hi millor que uns auriculars Bluetooth, que graven amb menys qualitat.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a room, the iPhone's microphone or a wired one usually hears better than Bluetooth headphones, which record at lower quality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una sala, el micrófono del iPhone o uno con cable suelen oír mejor que unos auriculares Bluetooth, que graban con menos calidad."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Areto batean, iPhonearen mikrofonoak edo kabledun batek hobeto entzun ohi dute Bluetooth entzungailuek baino, kalitate txikiagoz grabatzen baitute."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunha sala, o micrófono do iPhone ou un con cable adoitan oír mellor ca uns auriculares Bluetooth, que gravan con menos calidade."
          }
        }
      }
    },
    "Per desar el vídeo, permet que duna afegeixi fotos a Configuració.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para guardar el vídeo, permite que duna añada fotos en Ajustes."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gardar o vídeo, permite que duna engada fotos en Axustes."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bideoa gordetzeko, baimendu duna-ri argazkiak gehitzea Ezarpenak-en."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To save the video, allow duna to add photos in Settings."
          }
        }
      }
    },
