    "Amb AirDrop, el fitxer arriba a la carpeta Baixades del Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With AirDrop, the file lands in the Mac's Downloads folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con AirDrop, el archivo llega a la carpeta Descargas del Mac."
          }
        },
        "eu": {
