    "Allibera %@. Es pot tornar a baixar quan vulguis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frees %@. You can download it again whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera %@. Puedes volver a descargarlo cuando quieras."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ askatzen ditu. Nahi duzunean deskarga dezakezu berriro."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera %@. Podes volver descargalo cando queiras."
          }
        }
      }
    },
    "Allibera %@. És l'idioma que fas servir ara. Es pot tornar a baixar quan vulguis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frees %@. It's the language you're using now. You can download it again whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera %@. Es el idioma que usas ahora. Puedes volver a descargarlo cuando quieras."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ askatzen ditu. Orain erabiltzen ari zaren hizkuntza da. Nahi duzunean deskarga dezakezu berriro."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera %@. É o idioma que usas agora. Podes volver descargalo cando queiras."
          }
        }
      }
    },
