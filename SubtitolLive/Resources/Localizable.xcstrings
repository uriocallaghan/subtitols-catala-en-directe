    "La veu es transcriu al mateix telèfon. No s'envia àudio ni text enlloc, i l'app no recull cap dada.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech is transcribed on the phone itself. No audio or text is sent anywhere, and the app collects no data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz se transcribe en el propio teléfono. No se envía audio ni texto a ningún sitio, y la app no recoge ningún dato."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahotsa telefonoan bertan transkribatzen da. Ez da audiorik ez testurik inora bidaltzen, eta aplikazioak ez du daturik biltzen."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz transcríbese no propio teléfono. Non se envía audio nin texto a ningures, e a app non recolle ningún dato."
          }
        }
      }
    },
