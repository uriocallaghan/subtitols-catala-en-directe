    "La transcripció automàtica pot tenir errors. No substitueix un servei professional de subtitulació ni cap aparell auditiu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic transcription can make mistakes. It doesn't replace a professional captioning service or any hearing device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción automática puede tener errores. No sustituye a un servicio profesional de subtitulado ni a ningún audífono."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripzio automatikoak akatsak izan ditzake. Ez ditu ordezkatzen azpitituluen zerbitzu profesionalak ezta audifonoak ere."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrición automática pode ter erros. Non substitúe un servizo profesional de subtitulación nin ningún aparello auditivo."
          }
        }
      }
    },
