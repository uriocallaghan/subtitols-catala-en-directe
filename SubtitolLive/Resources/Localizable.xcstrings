    "Encara no hi ha cap idioma instal·lat. Obre duna per baixar-ne un.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha cap idioma instal·lat. Obre duna per baixar-ne un."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No language is installed yet. Open duna to download one."
          }
        },
