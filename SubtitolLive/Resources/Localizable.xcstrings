    "El text que mostra duna: el que està escoltant, l'última transcripció o els subtítols d'un vídeo acabat. Quan l'app es tanca, el text no es guarda.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El text que mostra duna: el que està escoltant, l'última transcripció o els subtítols d'un vídeo acabat. Quan l'app es tanca, el text no es guarda."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text duna is showing: what it is hearing, the last transcript, or a finished video's subtitles. When the app closes, the text is not kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto que muestra duna: lo que está escuchando, la última transcripción o los subtítulos de un vídeo terminado. Cuando la app se cierra, el texto no se guarda."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "duna-k erakusten duen testua: entzuten ari dena, azken transkripzioa edo amaitutako bideo baten azpitituluak. Aplikazioa ixten denean, testua ez da gordetzen."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto que mostra duna: o que está a escoitar, a última transcrición ou os subtítulos dun vídeo rematado. Cando a app se pecha, o texto non se garda."
          }
        }
      }
    },
    "Els subtítols queden dins la imatge, tal com els veus a la vista prèvia.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subtítulos quedan dentro de la imagen, tal como los ves en la vista previa."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Os subtítulos quedan dentro da imaxe, tal como os ves na vista previa."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azpitituluak irudiaren barruan geratzen dira, aurrebistan ikusten dituzun bezala."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subtitles become part of the picture, just as you see them in the preview."
          }
        }
      }
