diff --git a/src/asr/encoder/rel_pos_attention.cpp b/src/asr/encoder/rel_pos_attention.cpp
index f7fceda..bd586dd 100644
--- a/src/asr/encoder/rel_pos_attention.cpp
+++ b/src/asr/encoder/rel_pos_attention.cpp
@@ -116,7 +116,26 @@ RelPositionalEncoding::set_data(Session* session) {
     }
     std::vector<char> buffer(data_size);
     if (!session->params.pe_bin_path || session->params.pe_bin_path[0] == '\0') {
-        GGMLF_LOG_ERROR("pos_enc: no GGUF pe tensor and no pe_bin_path set");
+        // The table is a pure function of (d_model, max_len), so a GGUF may omit it
+        // (convert_model.py --no-embed-pe) to save 4 * d_model * (2 * max_len - 1)
+        // bytes. Mirror NeMo's float32 construction: the argument pos * div_term is
+        // rounded to float before sin/cos, exactly as torch does.
+        const int rows = max_len * 2 - 1;
+        std::vector<float> table(static_cast<size_t>(rows) * d_model);
+        const float scale = -(std::log(10000.0f) / static_cast<float>(d_model));
+        for (int row = 0; row < rows; ++row) {
+            const float position = static_cast<float>(max_len - 1 - row);
+            float* out = table.data() + static_cast<size_t>(row) * d_model;
+            for (int i = 0; i < d_model; i += 2) {
+                const float div_term = std::exp(static_cast<float>(i) * scale);
+                const float argument = position * div_term;
+                out[i] = static_cast<float>(std::sin(static_cast<double>(argument)));
+                if (i + 1 < d_model) {
+                    out[i + 1] = static_cast<float>(std::cos(static_cast<double>(argument)));
+                }
+            }
+        }
+        ggml_backend_tensor_set(pe_tensor.tensor, table.data(), 0, data_size);
         return;
     }
     auto file = ggml_fopen(session->params.pe_bin_path, "rb");
