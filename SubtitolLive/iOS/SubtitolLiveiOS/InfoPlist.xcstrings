{
  "sourceLanguage": "ca",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "duna escolta la veu per convertir-la en text al mateix iPhone. L'àudio no surt mai del telèfon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "duna escucha la voz para convertirla en texto en el propio iPhone. El audio nunca sale del teléfono."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "duna escoita a voz para convertela en texto no propio iPhone. O audio nunca sae do teléfono."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "duna-k ahotsa entzuten du, iPhonean bertan testu bihurtzeko. Audioa ez da inoiz telefonotik ateratzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "duna listens to speech to turn it into text right on your iPhone. The audio never leaves the phone."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "duna desa a Fotos els vídeos amb subtítols que facis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "duna guarda en Fotos los vídeos con subtítulos que hagas."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "duna garda en Fotos os vídeos con subtítulos que fagas."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "duna-k Argazkiak-en gordetzen ditu egiten dituzun azpitituludun bideoak."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "duna saves the subtitled videos you make to Photos."
          }
        }
      }
    }
  },
  "version": "1.0"
}
